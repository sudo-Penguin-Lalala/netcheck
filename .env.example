# Set to 1 to enable uvicorn access logs.
# Default: 0 (zero-log privacy mode). Server will not log visitor IPs or queries.
ACCESS_LOG=0

# Optional bearer token. When set, all /api/* requests must include
#   Authorization: Bearer <token>
# Note: as of v1.2.0, AUTH_TOKEN no longer implicitly unblocks private/loopback
# targets in ping/traceroute/port. Set ALLOW_PRIVATE_TARGETS=1 below to allow
# scanning RFC1918 / localhost from authenticated deploys. For one release
# only, setting AUTH_TOKEN without ALLOW_PRIVATE_TARGETS preserves legacy
# "trusted deploy" behavior and emits a deprecation warning to logs.
AUTH_TOKEN=

# Explicit SSRF gate for ping / traceroute / port / mtr.
#   1 / true / yes  -> allow targets like 10.0.0.1, 127.0.0.1, *.lan
#   0 / false / no  -> block private/loopback targets even if AUTH_TOKEN is set
#   unset           -> block, unless AUTH_TOKEN is set (legacy compat, removed in v2.0)
# Recommended for new homelab deploys: set this to 1, separately from AUTH_TOKEN.
ALLOW_PRIVATE_TARGETS=

# slowapi rate limit applied per-IP per-endpoint. Format: "<n>/<period>".
# Periods: second, minute, hour, day.
RATE_LIMIT=10/minute

# Comma-separated list of trusted upstream proxies whose
# X-Forwarded-For / X-Real-IP headers we honor. Anything not in this list
# is ignored and the per-IP rate limiter falls back to the TCP peer address.
#
# Default (set in Dockerfile): 127.0.0.1,172.16.0.0/12
#   - 127.0.0.1         -> host-networking deploys (uvicorn behind nginx on same host)
#   - 172.16.0.0/12     -> Docker default bridge / user-defined bridge networks
#
# Examples:
#   TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8   # nginx on host + private LAN proxy
#   TRUSTED_PROXIES=192.168.1.10           # only one specific reverse proxy
#   TRUSTED_PROXIES=                       # NO upstream proxy -- always use TCP peer
# NEVER set this to "*" in production. That trusts every source IP and lets
# clients forge X-Forwarded-For to bypass the per-IP rate limiter.
TRUSTED_PROXIES=

# CORS allowed origins. Empty = same-origin only.
# Use "*" to allow any origin, or a comma-separated list:
#   ALLOWED_ORIGINS=https://lab.example.com,https://dash.example.com
ALLOWED_ORIGINS=

# Globalping API -- used by /api/ping and /api/traceroute to run measurements
# from third-party probes (so the target never sees this server's IP).
# Anonymous default = 250 measurements/hour. Sign up at https://globalping.io
# for higher limits and paste the token below.
GLOBALPING_TOKEN=
# Override API base (rarely needed; default is the public endpoint)
# GLOBALPING_API=https://api.globalping.io/v1

# BKNS Whois API -- used by /api/whois for .vn domain lookups.
# Provides direct VNNIC relay with ~145ms latency for Vietnamese domains.
# Public tier: 10 req/min (no key needed). Partner tier: 300 req/min.
# Get partner key at https://bkns.vn or contact info@bkns.vn
BKNS_API_KEY=

# Persistent disk cache directory (used by WHOIS).
# Default: /data/netcheck-cache (created automatically by docker-entrypoint.sh)
# CACHE_DIR=/data/netcheck-cache
