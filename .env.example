# Optional bearer token. When set, all /api/* requests must include
#   Authorization: Bearer <token>
# Setting AUTH_TOKEN also disables the RFC1918/loopback block in
# ping/traceroute/port — use it only for trusted homelab deployments.
AUTH_TOKEN=

# slowapi rate limit applied per-IP per-endpoint. Format: "<n>/<period>".
# Periods: second, minute, hour, day.
RATE_LIMIT=10/minute

# CORS allowed origins. Empty = same-origin only.
# Use "*" to allow any origin, or a comma-separated list:
#   ALLOWED_ORIGINS=https://lab.example.com,https://dash.example.com
ALLOWED_ORIGINS=

# Globalping API — used by /api/ping and /api/traceroute to run measurements
# from third-party probes (so the target never sees this server's IP).
# Anonymous default = 250 measurements/hour. Sign up at https://globalping.io
# for higher limits and paste the token below.
GLOBALPING_TOKEN=
# Override API base (rarely needed; default is the public endpoint)
# GLOBALPING_API=https://api.globalping.io/v1
